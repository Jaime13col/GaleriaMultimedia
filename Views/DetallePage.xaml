<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GaleriaMultimedia.ViewModels"
             x:Class="GaleriaMultimedia.Views.DetallePage"
             x:DataType="vm:DetalleViewModel"
             Title="Detalle"
             BackgroundColor="{StaticResource Fondo}"
             Shell.NavBarIsVisible="False">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Foto grande + botón volver -->
		<Grid Grid.Row="0">
			<Image Source="{Binding Foto.Imagen}" Aspect="AspectFill" HeightRequest="320"
			       BackgroundColor="{StaticResource PlaceholderFoto}" />
			<Button Text="‹" FontSize="28" Padding="0,0,0,3" WidthRequest="44" HeightRequest="44"
			        CornerRadius="22" BackgroundColor="White" TextColor="{StaticResource Tinta}"
			        HorizontalOptions="Start" VerticalOptions="Start" Margin="16,36,0,0"
			        Command="{Binding VolverCommand}" />
		</Grid>

		<!-- Datos -->
		<ScrollView Grid.Row="1">
			<VerticalStackLayout Padding="20,20,20,20" Spacing="12">
				<Border HorizontalOptions="Start" Padding="16,6" BackgroundColor="{StaticResource ChipFondo}"
				        Stroke="Transparent" StrokeShape="RoundRectangle 16">
					<Label Text="{Binding Foto.Categoria}" FontAttributes="Bold" FontSize="14"
					       TextColor="{StaticResource ChipTexto}" />
				</Border>
				<Label Text="{Binding Foto.Titulo}" FontSize="30" FontAttributes="Bold"
				       TextColor="{StaticResource Tinta}" />
				<Label Text="{Binding Foto.FechaLarga, StringFormat='Tomada el {0}'}" FontSize="14"
				       TextColor="{StaticResource TextoSuave}" />
				<Label Text="{Binding Foto.Descripcion}" FontSize="16" LineHeight="1.3"
				       TextColor="{StaticResource Tinta}" />
			</VerticalStackLayout>
		</ScrollView>

		<!-- Acciones -->
		<VerticalStackLayout Grid.Row="2" Spacing="0">
			<BoxView HeightRequest="1" Color="{StaticResource Borde}" />
			<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="20,14,20,20">
				<Button Text="✏️  Editar" HeightRequest="56" CornerRadius="14" BackgroundColor="White"
				        TextColor="{StaticResource Tinta}" BorderColor="{StaticResource Borde}" BorderWidth="1.5"
				        Command="{Binding EditarCommand}" />
				<Button Grid.Column="1" Text="🔗  Compartir" HeightRequest="56" CornerRadius="14"
				        BackgroundColor="White" TextColor="{StaticResource Tinta}"
				        BorderColor="{StaticResource Borde}" BorderWidth="1.5"
				        Command="{Binding CompartirCommand}" />
				<Button Grid.Column="2" Text="🗑  Eliminar" HeightRequest="56" CornerRadius="14"
				        BackgroundColor="White" TextColor="{StaticResource Peligro}"
				        BorderColor="{StaticResource PeligroBorde}" BorderWidth="1.5"
				        Command="{Binding EliminarCommand}" />
			</Grid>
		</VerticalStackLayout>
	</Grid>
</ContentPage>
